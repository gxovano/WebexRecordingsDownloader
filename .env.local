client_id=
client_secret=
refresh_token=

# Caminho do CSV gerado (padrao: ../recordings.csv)
# RECORDINGS_CSV=/home/user/Video/recordings.csv

# Tres diretorios base, um por disco
# DOWNLOAD_DIRS=/mnt/disco1/WebexRecordings,/mnt/disco2/WebexRecordings,/mnt/disco3/WebexRecordings

# Workers paralelos por disco (padrao 1 em maquinas com ~8 GB RAM)
# WORKERS_PER_DISK=1

# Ajusta workers automaticamente com base na RAM disponivel
# AUTO_WORKERS=1

# Estimativa de memoria por worker e reserva para o sistema (MB)
# MEM_PER_WORKER_MB=400
# MEM_RESERVE_MB=2048

# Reinicios automaticos quando um worker e morto pelo kernel (OOM)
# MAX_WORKER_RESTARTS=5
# RESTART_DELAY_SEC=15

# Arquivo JSON com gravacoes concluidas e falhas (sobrevive a processos mortos pelo kernel)
# DOWNLOAD_STATE=/home/user/Video/WebexRecordingsDownloader/download_state.json